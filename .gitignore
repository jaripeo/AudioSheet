# Toolchain (recreated by `make bootstrap`)
.tooling/
core/.venv/
node_modules/

# Build output
dist/
build/
release/
*.tsbuildinfo

# Caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.turbo/
.vite/

# Project cache (content-addressed stage output; safe to delete)
.audiosheet/

# Vendored model binaries. Tracked with git-lfs in a real checkout
# (models/.gitattributes); ignored here so an un-LFS'd clone stays clean.
models/**/*.onnx
models/**/*.th
models/**/*.pt
models/**/*.sf2

# Fixture audio is generated by scripts/make_fixtures.py, not committed.
core/tests/fixtures/synth/*.wav
core/tests/fixtures/timing/*.wav
core/tests/fixtures/adversarial/*.wav
core/tests/fixtures/real/*.mp3
core/tests/fixtures/real/*.wav

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/
!.vscode/extensions.json
